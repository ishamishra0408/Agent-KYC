# Copy to .env and fill in. Never commit .env.
# Everything is optional: without these, the app runs offline with its stand-ins (tests always do).

# Phase 3: models, all through OpenRouter (D-033): Claude and the open-weight challengers.
# openrouter.ai/keys. Give the key a credit limit.
OPENROUTER_API_KEY=
# With a key, the app reads photos with Gemma 4 31B and Claude Sonnet as the fallback (D-038).
# READER=simulated keeps the stand-in. Spend stops at READER_BUDGET_USD per server run.
READER=
READER_BUDGET_USD=1
READER_TIMEOUT_MS=15000

# Phase 5: trust graph (Neo4j Aura Free)
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
# Newer Aura instances name the database after the instance id (it's in the credentials file).
NEO4J_DATABASE=
# With an instance, the trust graph runs on Neo4j (D-039); GRAPH=memory keeps the in-memory one.
GRAPH=

# Phase 6: voice notes
PLAUD_API_KEY=
