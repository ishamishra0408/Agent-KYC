# Agent KYCReady — architecture and flow
#
# Install once:   brew install d2
# Live preview:   d2 --layout=elk --watch architecture.d2
# Export:         d2 --layout=elk architecture.d2 architecture.svg
#
# Read it: bold numbered arrows (1-14) follow one driver from nudge to unlocked loads.
# Boxes with a small (i) icon have a tooltip: hover the icon to see what the box does.

direction: right

classes: {
  ai: {
    style: {
      fill: "#F3E8FF"
      stroke: "#7C3AED"
      stroke-dash: 4
      font-color: "#3B0764"
    }
  }
