    }
  }
  store: {
    style: {
      fill: "#FEF9C3"
      stroke: "#A16207"
      font-color: "#422006"
    }
  }
  offbox: {
    style: {
      fill: "#F8FAFC"
      stroke: "#94A3B8"
      stroke-dash: 5
      font-color: "#475569"
    }
  }
  journey: {
    style: {
      stroke: "#0F172A"
      stroke-width: 3
